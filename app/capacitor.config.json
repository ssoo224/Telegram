{
  "appId": "com.babylon.chat",
  "appName": "Babylon Chat",
  "webDir": "www",
  "server": {
    "url": "https://babyllon.vercel.app",
    "cleartext": false,
    "allowNavigation": [
      "babyllon.vercel.app",
      "*.firebaseapp.com",
      "*.googleapis.com"
    ]
  },
  "android": {
    "allowMixedContent": false
  },
  "plugins": {
    "PushNotifications": {
      "presentationOptions": [
        "badge",
        "sound",
        "alert"
      ]
    }
  }
}
